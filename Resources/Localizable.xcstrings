    "integrations.group_api_key_desc": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are used only to calibrate and refine usage statistics — they do not unlock any features. We do not provide these keys. Users generate them on each AI provider's website. Keys are stored locally only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填入 Key 仅用于校正和精确化用量统计，不解锁任何额外功能。Key 由各 AI 服务商提供，我们不提供这些 Key。用户需自行在各厂商官网生成。Key 仅存储在本地。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰僅用於校準和精化用量統計 — 不會解鎖任何功能。我們不提供這些金鑰。使用者需在各 AI 供應商網站上自行產生。金鑰僅儲存在本機。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "密鑰僅用於校準和精細化用量統計 — 唔會解鎖任何功能。我哋唔提供呢啲密鑰。使用者需喺各 AI 供應商網站自行產生。密鑰僅儲存喺本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは使用量統計の調整と精度向上にのみ使用 — 機能のロック解除には使用されません。これらのキーは提供していません。ユーザーが各AIプロバイダーのサイトで生成します。キーはローカルのみに保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 사용량 통계 보정 및 정제에만 사용 — 기능 잠금 해제 없음. 당사는 키를 제공하지 않습니다. 사용자가 각 AI 제공자 사이트에서 생성합니다. 키는 로컬에만 저장."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys dienen nur zur Kalibrierung und Verfeinerung von Nutzungsstatistiken — sie schalten keine Funktionen frei. Wir stellen diese Keys nicht bereit. Nutzer generieren sie auf den jeweiligen KI-Anbieter-Websites. Keys werden nur lokal gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés servent uniquement à calibrer et affiner les statistiques — elles ne débloquent aucune fonction. Nous ne fournissons pas ces clés. Les utilisateurs les génèrent sur le site de chaque fournisseur. Stockage local uniquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves solo calibran y refinan estadísticas de uso — no desbloquean funciones. No proporcionamos estas claves. Los usuarios las generan en el sitio de cada proveedor. Almacenamiento solo local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves apenas calibram e refinam estatísticas de uso — não desbloqueiam recursos. Não fornecemos essas chaves. Os usuários as geram no site de cada provedor. Armazenamento apenas local."
          }
        }
      }
    },
