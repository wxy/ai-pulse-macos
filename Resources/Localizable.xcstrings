    "anomaly.body": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spent $%@ — 3× the 7‑day hourly baseline ($%@/hr)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 点花费 $%@，超过 7 日均值 3 倍（$%@/小时）"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 花費 $%@ — 是 7 天平均時薪 ($%@/hr) 的 3 倍"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 花費 $%@ — 係 7 日平均時薪 ($%@/hr) 嘅 3 倍"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が $%@ 消費 — 7日平均時給 ($%@/hr) の 3 倍"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 지출 $%@ — 7일 시간당 평균 ($%@/hr) 의 3배"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gab $%@ aus — 3× der 7-Tage-Stundenbasis ($%@/Std)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a dépensé $%@ — 3× la base horaire sur 7 jours ($%@/h)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gastó $%@ — 3× el promedio horario de 7 días ($%@/h)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gastou $%@ — 3× a média horária de 7 dias ($%@/h)"
          }
        }
      }
    },
