  "strings": {
    "about.desc": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know what AI coding really costs you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道你 AI 编程的真实成本。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "了解 AI 程式開發的真實成本。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "了解 AI 程式開發嘅真實成本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIコーディングの真のコストを知る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 코딩의 실제 비용을 알아보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahre, was KI-Coding wirklich kostet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez le vrai coût du codage IA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre lo que realmente cuesta programar con IA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiba o que a programação com IA realmente custa."
          }
        }
      }
    },
    "about.privacy": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data stays on your machine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据仅存储在本机。"
