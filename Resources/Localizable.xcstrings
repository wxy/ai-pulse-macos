    "bookmark.claude_message": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse needs to read the ~/.claude folder to track Claude Code usage. Please grant access here (used locally only)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse 需要读取 ~/.claude 目录以统计 Claude Code 用量。请在此确认授权（仅本机使用）。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse 需要讀取 ~/.claude 資料夾來追蹤 Claude Code 使用量。請在此授權（僅本機使用）。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse 需要讀取 ~/.claude 資料夾以追蹤 Claude Code 使用量。請喺度授權（僅本機使用）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse は Claude Code の使用状況追跡のため ~/.claude へのアクセスが必要です。許可してください（ローカルのみ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse가 Claude Code 사용량 추적을 위해 ~/.claude 폴더에 접근해야 합니다. 접근을 허용해 주세요 (로컬 전용)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse benötigt Lesezugriff auf ~/.claude, um Claude Code zu verfolgen. Bitte Zugriff gewähren (nur lokal)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse a besoin de lire ~/.claude pour suivre l'utilisation de Claude Code. Veuillez autoriser l'accès (local uniquement)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse necesita leer ~/.claude para rastrear el uso de Claude Code. Concede acceso aquí (solo local)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse precisa ler ~/.claude para rastrear o uso do Claude Code. Conceda acesso aqui (apenas local)."
          }
        }
      }
    },
