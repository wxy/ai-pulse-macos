    "apikeys.desc": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure API keys for official usage data. Without a key, local log estimates are used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置 API Key 以获取官方用量数据。不配置则使用本地日志估算。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 API 金鑰以取得官方用量資料。沒有金鑰時，會使用本機記錄估算。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 API 密鑰以取得官方用量數據。冇密鑰時，會使用本機記錄估算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを設定して公式の利用データを取得。キーがない場合はローカルログから推定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 사용량 데이터를 위해 API 키를 설정하세요. 키가 없으면 로컬 로그로 추정합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Keys für offizielle Nutzungsdaten konfigurieren. Ohne Key werden lokale Logs geschätzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les clés API pour les données d'utilisation officielles. Sans clé, les logs locaux sont estimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura claves API para datos de uso oficiales. Sin clave, se usan estimaciones de logs locales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure chaves de API para dados oficiais de uso. Sem chave, logs locais são usados."
          }
        }
      }
    },
