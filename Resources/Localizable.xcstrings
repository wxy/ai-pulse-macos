        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料淨係儲存喺你部機度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータは端末内に保存。"
