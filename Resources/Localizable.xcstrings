    "dashboard.cpl_unavailable_desc": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Claude Code or aider to calculate CPL stats. These tools write local logs that can be accurately attributed to repos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Claude Code 或 aider 以计算 CPL 统计。这些工具会写入本地日志，可精确归因到仓库。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 Claude Code 或 aider 以計算 CPL 統計。這些工具寫入本機記錄，可準確歸因至儲存庫。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 Claude Code 或 aider 以計算 CPL 統計。呢啲工具寫入本機記錄，可準確歸因至儲存庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPL統計を計算するには Claude Code または aider を有効にしてください。これらのツールはローカルログを書き込み、リポジトリに正確に帰属できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPL 통계를 계산하려면 Claude Code 또는 aider를 활성화하세요. 이 도구들은 로컬 로그를 작성하여 저장소에 정확히 귀속됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Claude Code oder aider, um CPL-Statistiken zu berechnen. Diese Tools schreiben lokale Logs, die Repos zugeordnet werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Claude Code ou aider pour calculer les stats CPL. Ces outils écrivent des logs locaux attribuables aux dépôts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Claude Code o aider para calcular estadísticas CPL. Estas herramientas escriben logs locales atribuibles a repositorios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Claude Code ou aider para calcular estatísticas CPL. Essas ferramentas gravam logs locais atribuíveis a repositórios."
          }
        }
      }
    },
