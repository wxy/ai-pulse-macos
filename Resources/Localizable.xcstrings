    "demo.onboarding_msg": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will run in demo mode with sample data. Configure real tools in Settings → Integrations to exit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用将以演示模式运行，展示模拟数据。随时前往 设置 → 集成 配置真实工具后自动退出。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式將以示範模式執行，使用範例資料。在「設定 → 整合」中設定真實工具以退出。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式會以示範模式執行，使用範例數據。喺「設定 → 整合」設定真實工具以退出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはサンプルデータでデモモード実行されます。「設定 → 統合」で実際のツールを設定すると終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 샘플 데이터로 데모 모드로 실행됩니다. 설정 → 통합에서 실제 도구를 구성하면 종료됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App läuft im Demo-Modus mit Beispieldaten. Echte Tools unter Einstellungen → Integrationen konfigurieren zum Beenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app fonctionne en mode démo avec des données exemples. Configurez de vrais outils dans Réglages → Intégrations pour quitter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ejecuta en modo demo con datos de ejemplo. Configura herramientas reales en Ajustes → Integraciones para salir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app roda em modo demo com dados de exemplo. Configure ferramentas reais em Ajustes → Integrações para sair."
          }
        }
      }
    },
