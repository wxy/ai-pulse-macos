    "repos.delete_msg": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop monitoring '%@'?\nIts repos will no longer be tracked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止监控 '%@'？\n其仓库将不再被追踪。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "停止監控 '%@'？\n將不再追蹤其儲存庫。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "停止監控 '%@'？\n將唔再追蹤其儲存庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' の監視を停止しますか？\nこのリポジトリは追跡されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 모니터링을 중지하시겠습니까?\n해당 저장소가 더 이상 추적되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überwachung von '%@' beenden?\nSeine Repos werden nicht mehr verfolgt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la surveillance de '%@' ?\nSes dépôts ne seront plus suivis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dejar de monitorizar '%@'?\nSus repositorios ya no serán rastreados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar de monitorar '%@'?\nSeus repositórios não serão mais rastreados."
          }
        }
      }
    },
