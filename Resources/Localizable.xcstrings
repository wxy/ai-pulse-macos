    "repos.grant_empty": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No directories authorized yet. Click “Add Directory” to choose where your code repositories live (e.g. ~/dev); AI Pulse will scan it for Git repos after you grant access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授权任何目录。点击“添加目录”选择存放代码仓库的目录（如 ~/dev），授权后即可扫描其中的 Git 仓库。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授權任何目錄。點擊「新增目錄」選擇程式碼儲存庫所在位置（例如 ~/dev）；AI Pulse 將在授權後掃描 Git 儲存庫。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授權任何目錄。點擊「新增目錄」揀程式碼儲存庫所在位置（例如 ~/dev）；AI Pulse 會喺授權後掃描 Git 儲存庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだディレクトリが許可されていません。「ディレクトリ追加」をクリックしてコードリポジトリのある場所（例: ~/dev）を選択。AI Pulse がアクセス許可後にGitリポジトリをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 승인된 디렉토리가 없습니다. '디렉토리 추가'를 클릭하여 코드 저장소 위치(예: ~/dev)를 선택하세요. AI Pulse가 접근 승인 후 Git 저장소를 스캔합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Verzeichnisse autorisiert. Klicke \"Verzeichnis hinzufügen\" und wähle den Ort deiner Code-Repos (z.B. ~/dev). AI Pulse durchsucht es nach Zugriffsgewährung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier autorisé pour l'instant. Cliquez sur « Ajouter un dossier » pour choisir où se trouvent vos dépôts (ex. ~/dev). AI Pulse les analysera après autorisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay directorios autorizados. Haz clic en \"Añadir directorio\" para elegir dónde están tus repositorios (ej. ~/dev). AI Pulse los escaneará tras conceder acceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum diretório autorizado ainda. Clique em \"Adicionar diretório\" para escolher onde estão seus repositórios (ex. ~/dev). AI Pulse os escaneará após conceder acesso."
          }
        }
      }
    },
