    "integrations.group_editors_desc": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI coding tools are tracked automatically via local log parsing and subscription detection. They are discovered on install — no additional setup needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 编程工具通过本地日志解析和订阅检测自动追踪。安装后自动发现，无需额外配置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 程式碼工具透過本機記錄解析和訂閱偵測自動追蹤。安裝後自動發現 — 無需額外設定。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 程式碼工具透過本機記錄解析同訂閱偵測自動追蹤。安裝後自動發現 — 無需額外設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIコーディングツールはローカルログ解析とサブスクリプション検出により自動追跡。インストール時に発見 — 追加設定不要。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 코딩 도구는 로컬 로그 파싱 및 구독 감지로 자동 추적. 설치 시 발견 — 추가 설정 불필요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Coding-Tools werden automatisch über lokales Log-Parsing und Abo-Erkennung verfolgt. Bei Installation erkannt — keine weitere Einrichtung nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils de codage IA sont suivis automatiquement via l'analyse des logs locaux et la détection d'abonnement. Découverts à l'installation — aucune configuration supplémentaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas de codificación IA se rastrean automáticamente mediante análisis de logs locales y detección de suscripción. Descubiertas al instalar — sin configuración adicional."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferramentas de código IA são rastreadas automaticamente via análise de logs locais e detecção de assinatura. Descobertas na instalação — sem configuração adicional."
          }
        }
      }
    },
