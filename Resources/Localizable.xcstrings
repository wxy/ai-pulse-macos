    "subs.copilot_note": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot now uses credits-based billing. Over-quota usage cannot be tracked. Base monthly fee only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot 已转为用量计费（AI Credits），超出月配额部分无法追踪。仅统计基础月费。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot 現已採用點數計費。超出配額的用量無法追蹤。僅基本月費。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot 現已採用積分計費。超出配額嘅用量無法追蹤。僅基本月費。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot はクレジットベースの課金に移行。超過利用は追跡不可。基本月額のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot은 이제 크레딧 기반 과금. 초과 사용량 추적 불가. 기본 월 요금만 해당."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot nutzt jetzt Credits-basierte Abrechnung. Übermäßige Nutzung nicht verfolgbar. Nur Grundgebühr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot utilise désormais une facturation par crédits. L'utilisation au-delà du quota ne peut pas être suivie. Forfait de base uniquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot ahora usa facturación por créditos. El uso excedente no se puede rastrear. Solo tarifa base mensual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot agora usa cobrança por créditos. Uso excedente não pode ser rastreado. Apenas taxa base mensal."
          }
        }
      }
    },
