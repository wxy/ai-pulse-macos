    "subs.desc": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly fee tools. Cost per line = fee / net committed lines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月费工具。单行成本 = 月费 / 净提交行数。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "月費工具。每行成本 = 費用 / 淨提交行數。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "月費工具。每行成本 = 費用 / 淨提交行數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額課金ツール。行あたりコスト = 料金 / 純コミット行数。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 요금 도구. 줄당 비용 = 요금 / 순 커밋 줄 수."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatliche Tools. Kosten pro Zeile = Gebühr / Netto-Commit-Zeilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outils à frais mensuels. Coût par ligne = frais / lignes nettes commitées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Herramientas de tarifa mensual. Coste por línea = tarifa / líneas netas commitadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferramentas de taxa mensal. Custo por linha = taxa / linhas líquidas commitadas."
          }
        }
      }
    },
