    "onboarding.detected_hint": {
      "extractionState": "manual",
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable to automatically track spending. Add provider balance monitoring too. More in Settings → Integrations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后自动追踪花费。还可添加 AI 服务商余额监控。更多见设置 → 集成。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用以自動追蹤支出。也可新增供應商餘額監控。更多選項在「設定 → 整合」。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用以自動追蹤支出。亦可以新增供應商餘額監控。更多選項喺「設定 → 整合」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にして自動的に支出を追跡。プロバイダー残高監視の追加も可能。詳細は「設定 → 統合」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하여 지출 자동 추적. 제공자 잔액 모니터링 추가 가능. 설정 → 통합에서 더 보기."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren für automatische Ausgabenverfolgung. Auch Anbieter-Guthabenüberwachung hinzufügbar. Mehr unter Einstellungen → Integrationen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez pour suivre automatiquement les dépenses. Ajoutez aussi la surveillance du solde fournisseur. Plus dans Réglages → Intégrations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa para rastrear gastos automáticamente. También puedes añadir monitorización de saldo del proveedor. Más en Ajustes → Integraciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para rastrear gastos automaticamente. Também adicione monitoramento de saldo do provedor. Mais em Ajustes → Integrações."
          }
        }
      }
    },
