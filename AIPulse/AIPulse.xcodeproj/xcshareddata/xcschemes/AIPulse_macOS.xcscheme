               scriptText = "#!/bin/sh&#10;set -e&#10;DSYM_SRC=&quot;${HOME}/develop/ai-pulse-macos/Libraries/libgit2/lib/libgit2.1.9.dylib.dSYM&quot;&#10;if [ -d &quot;${DSYM_SRC}&quot; ] &amp;&amp; [ -d &quot;${ARCHIVE_PATH}/dSYMs&quot; ]; then&#10;  cp -R &quot;${DSYM_SRC}&quot; &quot;${ARCHIVE_PATH}/dSYMs/&quot;&#10;  echo &quot;Copied libgit2 dSYM into archive dSYMs folder&quot;&#10;else&#10;  echo &quot;Skipped libgit2 dSYM copy (source or dSYMs folder not found)&quot;&#10;fi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "C0843E1C2FF555ED00E3F6C4"
                     BuildableName = "AI Pulse.app"
                     BlueprintName = "AI Pulse"
                     ReferencedContainer = "container:AIPulse.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
