    "dashboard.model_data_bar_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Balken vergleichen Modelle je Zahlenspalte mit deren größtem Detailwert. Summenzeilen zählen nicht zur Skalierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar lengths compare models within each numeric column, relative to that column’s largest detail value. Summary totals are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras comparan modelos dentro de cada columna numérica respecto a su mayor valor de detalle. Los totales se excluyen de la escala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres comparent les modèles dans chaque colonne numérique à sa plus grande valeur détaillée. Les totaux sont exclus de l’échelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーは各数値列内でモデルを比較します。その列の明細最大値が全幅となり、集計行は尺度に含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막대는 각 숫자 열 안에서 모델을 비교합니다. 해당 열의 상세 최댓값이 전체 너비이며 합계 행은 배율에서 제외됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras comparam modelos em cada coluna numérica com o maior valor detalhado dessa coluna. Os totais não entram na escala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据条在每个数值列内比较模型，以该列明细最大值为满格；合计行不参与缩放。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "資料條在每個數值欄內比較模型，以該欄明細最大值為滿格；合計列不參與縮放。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "資料條在每個數值欄內比較模型，以該欄明細最大值為滿格；合計列不參與縮放。"
          }
        }
      }
    },
