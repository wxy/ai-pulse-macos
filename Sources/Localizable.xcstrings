          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그는 로컬에서 읽습니다. 릴리스 빌드는 API 키를 제외한 대시보드 요약을 사용자의 비공개 iCloud 데이터베이스로 동기화합니다."
          }
        },
        "de": {
          "stringUnit": {
