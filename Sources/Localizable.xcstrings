    "dashboard.scan_warning_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte lokale Scan ist nicht verfügbar oder veraltet. Historische Daten bleiben sichtbar, belegen aber keine aktuell funktionierende Erfassung. Diagnoseprotokoll öffnen; die Ursache ist noch unbekannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest local scan is unavailable or out of date. Historical data is still visible, but does not prove collection is working now. Open diagnostics to investigate; the cause is not yet known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último escaneo local no está disponible o está desactualizado. El historial sigue visible, pero no prueba que la recopilación funcione ahora. Consulte los diagnósticos; la causa aún no se conoce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier scan local est indisponible ou périmé. L’historique reste visible, sans prouver que la collecte fonctionne actuellement. Consultez les diagnostics ; la cause n’est pas encore connue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のローカルスキャンは利用不可または期限切れです。履歴は表示できますが、現在の収集が正常とは限りません。診断ログを確認してください。原因は未確認です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 로컬 스캔을 사용할 수 없거나 오래되었습니다. 과거 데이터는 보이지만 현재 수집이 정상이라는 증거는 아닙니다. 진단 로그를 확인하세요. 원인은 아직 확인되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última varredura local está indisponível ou desatualizada. O histórico continua visível, mas não prova que a coleta funciona agora. Abra os diagnósticos; a causa ainda não foi confirmada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的本地扫描不可用或已过期。历史数据仍可查看，但不能证明当前采集正常。可打开诊断日志检查，具体原因尚未确认。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的本地掃描不可用或已過期。歷史資料仍可查看，但不能證明當前採集正常。可開啟診斷日誌檢查，具體原因尚未確認。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的本地掃描不可用或已過期。歷史資料仍可查看，但不能證明當前採集正常。可開啟診斷日誌檢查，具體原因尚未確認。"
          }
        }
      }
    },
