        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式會以示範模式執行，使用範例數據。喺「設定 → 整合」設定真實工具以退出。"
          }
        },
        "zh-Hant-TW": {
