    "Could not fetch all cloud data. Local cached data is preserved. Check your network and Mac sync status, then retry.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのクラウドデータを取得できませんでした。ローカルのキャッシュデータは保持されています。ネットワークとMacの同期状態を確認して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完整读取云端数据，已保留本地缓存。请检查网络与 Mac 同步状态后重试。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完整讀取雲端資料，已保留本地快取。請檢查網絡與 Mac 同步狀態後重試。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完整讀取雲端資料，已保留本地快取。請檢查網路與 Mac 同步狀態後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 클라우드 데이터를 가져오지 못했습니다. 로컬 캐시 데이터는 유지됩니다. 네트워크와 Mac 동기화 상태를 확인한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Cloud-Daten konnten abgerufen werden. Lokale Cache-Daten bleiben erhalten. Prüfe Netzwerk und Mac-Synchronisierung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de récupérer toutes les données du cloud. Les données locales en cache sont conservées. Vérifiez le réseau et la synchronisation du Mac, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron obtener todos los datos de la nube. Se conservaron los datos locales en caché. Comprueba la red y el estado de sincronización del Mac y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter todos os dados da nuvem. Os dados locais em cache foram preservados. Verifique a rede e o status de sincronização do Mac e tente novamente."
          }
        }
      }
    },
    "Could not request notification permission. Retry later or open system settings.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の許可を要求できませんでした。後で再試行するか、システム設定を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法申请通知授权，请稍后重试或前往系统设置。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法申請通知授權，請稍後重試或前往系統設定。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法申請通知授權，請稍後重試或前往系統設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한을 요청할 수 없습니다. 나중에 다시 시도하거나 시스템 설정을 여세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungsberechtigung konnte nicht angefordert werden. Versuche es später erneut oder öffne die Systemeinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de demander l’autorisation des notifications. Réessayez plus tard ou ouvrez Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo solicitar permiso para las notificaciones. Inténtalo más tarde o abre los ajustes del sistema."
