    "onboarding.blindspot_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct API usage (your own scripts) leaves no local logs — add an API key under Integrations (Optional) if you want it measured."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自スクリプトによるAPIの直接利用ではローカルログが残りません。計測する場合は「連携（任意）」でAPIキーを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接调用 API 的用量（自写脚本）没有本地日志——如需计量，请在「集成（可选增强）」中添加 API Key。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "直接調用 API 的用量（自寫腳本）沒有本地記錄——如需計量，請在「集成（可選增強）」中添加 API Key。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "直接調用 API 的用量（自寫腳本）沒有本地記錄——如需計量，請在「集成（可選增強）」中新增 API Key。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 API를 사용하면(직접 작성한 스크립트) 로컬 로그가 남지 않습니다. 측정하려면 통합(선택 사항)에서 API 키를 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte API-Nutzung (eigene Skripte) hinterlässt keine lokalen Protokolle. Füge unter Integrationen (optional) einen API-Schlüssel hinzu, wenn sie erfasst werden soll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisation directe de l’API (vos propres scripts) ne laisse aucun journal local. Ajoutez une clé API dans Intégrations (facultatif) pour la mesurer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso directo de la API (tus propios scripts) no deja registros locales; añade una clave API en Integraciones (opcional) si quieres medirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O uso direto da API (seus próprios scripts) não deixa registros locais — adicione uma chave de API em Integrações (opcional) se quiser medi-lo."
          }
        }
      }
    },
