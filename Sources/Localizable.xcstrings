    "integrations.desc" : {
      "comment" : "Keep translation short — UI label, avoid layout overflow",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützte Tools und Dienste sind unten aufgeführt. Konfiguriere sie für automatische KI-Kostenverfolgung. Keys dienen nur zur Kalibrierung — sie schalten keine Funktionen frei. Alle Daten bleiben lokal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supported tools and services are shown below. Configure them to automatically track AI spending. Keys only calibrate usage stats — they do not unlock features. All data stays on your machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las herramientas y servicios compatibles se muestran abajo. Configúralos para rastrear automáticamente el gasto en IA. Las claves solo calibran estadísticas — no desbloquean funciones. Todos los datos permanecen locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les outils et services pris en charge sont listés ci-dessous. Configurez-les pour suivre automatiquement les dépenses IA. Les clés servent uniquement à calibrer les statistiques. Toutes les données restent locales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下に対応ツールとサービスを表示します。設定するとAI支出を自動追跡。キーは使用量統計の調整にのみ使用され、機能のロック解除には使用されません。全データは端末に保存。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원 도구 및 서비스가 아래에 표시됩니다. 구성하면 AI 지출을 자동 추적합니다. 키는 사용량 통계 보정에만 사용되며 기능을 잠금 해제하지 않습니다. 모든 데이터는 기기에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferramentas e serviços compatíveis são mostrados abaixo. Configure-os para rastrear gastos com IA automaticamente. As chaves apenas calibram estatísticas — não desbloqueiam recursos. Todos os dados ficam locais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持的工具和服务显示如下。配置后即可自动追踪 AI 花费。填入 Key 仅用于校正用量，不解锁额外功能，所有数据仅存储在本地。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下方列出支援嘅工具與服務。設定後將自動追蹤 AI 支出。密鑰僅用於校準用量統計 — 唔會解鎖功能。所有資料淨係儲存喺你部機。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下方列出支援的工具與服務。設定後將自動追蹤 AI 支出。金鑰僅用於校準用量統計 — 不會解鎖功能。所有資料僅儲存在你的電腦上。"
          }
        }
      }
    },
