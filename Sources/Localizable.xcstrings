    "Local activity and account observations update separately; money and Git output remain independent.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルアクティビティとアカウント観測は別々に更新され、金額とGit出力も独立して表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地活动与账户观测分别更新；费用与代码产出分别呈现。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本地活動與帳戶觀測分別更新；費用與程式碼產出分別呈現。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本地活動與帳戶觀測分別更新；費用與程式碼產出分別呈現。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 활동과 계정 관측은 별도로 업데이트되며 금액과 Git 결과물도 서로 독립적입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Aktivität und Kontobeobachtungen werden getrennt aktualisiert; Geld und Git-Ausgabe bleiben unabhängig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activité locale et les observations du compte sont mises à jour séparément ; l’argent et la sortie Git restent indépendants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad local y las observaciones de cuenta se actualizan por separado; el dinero y la producción de Git son independientes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atividade local e as observações da conta são atualizadas separadamente; valores monetários e produção do Git permanecem independentes."
          }
        }
      }
    },
