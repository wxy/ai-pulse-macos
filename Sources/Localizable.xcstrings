    "settings.integrations_privacy_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten werden aus lokalen Protokollen gelesen und bleiben auf Ihrem Gerät. Es wird nichts hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data is read from local logs and stays on your machine. Nothing is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los datos se leen de registros locales y permanecen en su máquina. Nada se sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données sont lues à partir des journaux locaux et restent sur votre machine. Rien n'est téléchargé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータはローカルログから読み取られ、端末に残ります。アップロードはされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터는 로컬 로그에서 읽어 기기에 유지되며 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados são lidos de logs locais e permanecem na sua máquina. Nada é enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据均从本地日志读取并保留在本机，不会上传。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料皆從本機日誌讀取並保留在本機，不會上傳。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料皆從本機日誌讀取並保留在本機，不會上傳。"
          }
        }
      }
    },
