    "Account observations and fixed costs are optional and can be configured later.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント観測と固定費は任意で、後から設定できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户观测和固定费用都是可选配置，可以以后在设置中添加。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶觀測和固定費用都是可選設定，可以以後在設定中添加。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶觀測和固定費用都是可選設定，可以以後在設定中新增。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 관측과 고정 비용은 선택 사항이며 나중에 구성할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontobeobachtungen und Fixkosten sind optional und können später konfiguriert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les observations du compte et les coûts fixes sont facultatifs et peuvent être configurés ultérieurement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las observaciones de cuenta y los costes fijos son opcionales y se pueden configurar más tarde."
          }
        },
        "pt-BR": {
