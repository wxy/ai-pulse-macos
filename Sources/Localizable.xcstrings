    "pulse.activity.legend": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flamme und Roboterlampe teilen die aktuelle Token-Intensität: Grau ruhig oder unbekannt, Gold aktiv, Orange erhöht, Rot intensiv. Kurzes Aufleuchten zeigt eine neue Verbrauchsbeobachtung, nicht Geld oder Kontingent. Der Text unterscheidet unbekannt von ruhig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flame and robot lamp share current token intensity: gray calm or unknown, gold active, orange elevated, red intense. A brief highlight means a new consumption observation, not money or quota. Text distinguishes unavailable from calm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llama y la luz del robot comparten la intensidad de tokens: gris tranquila o desconocida, dorado activa, naranja elevada, rojo intensa. Un breve brillo indica una nueva observación de consumo, no dinero ni cuota. El texto distingue desconocida de tranquila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La flamme et le voyant du robot partagent l’intensité des tokens : gris calme ou inconnue, or active, orange élevée, rouge intense. Un bref éclairage signale une nouvelle consommation observée, pas de l’argent ni un quota. Le texte distingue inconnue de calme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "炎とロボットのランプは同じトークン活動強度を示します。灰色は平静または不明、金色は活動中、橙色は高め、赤色は高強度です。一時的な点灯は新しい消費の観測で、金額や使用枠ではありません。不明と平静は文字で区別します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불꽃과 로봇 표시등은 같은 토큰 활동 강도를 표시합니다. 회색은 평온 또는 알 수 없음, 금색은 활동 중, 주황은 높음, 빨강은 강한 활동입니다. 짧은 빛은 새 소비 관측이며 금액이나 한도가 아닙니다. 알 수 없음과 평온은 텍스트로 구분합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chama e luz do robô compartilham a intensidade de tokens: cinza calma ou desconhecida, dourado ativa, laranja elevada, vermelho intensa. Um breve brilho indica nova observação de consumo, não dinheiro ou cota. O texto distingue desconhecida de calma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "火焰与机器人状态灯共用当前词元活动强度：灰色为平静或未知，金色为正在投入，橙色为投入较高，暖红为高强度。短暂亮起表示新观察到消费，不是金额或额度；未知与平静通过文字区分。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "火焰與機器人狀態燈共用當前詞元活動強度：灰色為平靜或未知，金色為正在投入，橙色為投入較高，暖紅為高強度。短暫亮起表示新觀察到消費，不是金額或額度；未知與平靜透過文字區分。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "火焰與機器人狀態燈共用當前詞元活動強度：灰色為平靜或未知，金色為正在投入，橙色為投入較高，暖紅為高強度。短暫亮起表示新觀察到消費，不是金額或額度；未知與平靜透過文字區分。"
          }
        }
      }
    },
    "pulse.activity.personal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Token-Intensität: %@× historische Referenz (kein gemessener Stundenverbrauch)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent token intensity: %@× historical reference (not measured hourly usage)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidad reciente de tokens: %@× la referencia histórica (no uso horario medido)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensité récente des tokens : %@× la référence historique (pas l’usage horaire mesuré)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のトークン活動強度：履歴基準の%@倍（実測時間使用量ではありません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 토큰 활동 강도: 과거 기준의 %@배(실측 시간당 사용량 아님)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidade recente de tokens: %@× a referência histórica (não é uso horário medido)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期词元活动强度为历史参考的 %@ 倍（非实际每小时用量）。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "近期詞元活動強度為歷史參考的 %@ 倍（非實際每小時用量）。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
