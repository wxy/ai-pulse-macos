    "bookmark.home_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewähren Sie Zugriff auf Ihren Home-Ordner, damit AI Pulse Ihre KI-Programmiertools erkennen kann. Daten bleiben auf Ihrem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant access to your home folder so AI Pulse can detect your AI coding tools. Data stays on your machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda acceso a su carpeta de inicio para que AI Pulse pueda detectar sus herramientas de programación IA. Los datos permanecen en su máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à votre dossier personnel pour que AI Pulse puisse détecter vos outils de codage IA. Les données restent sur votre machine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームフォルダへのアクセスを許可し、AI Pulse が AI コーディングツールを検出できるようにします。データは端末に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 폴더에 대한 접근을 허용하여 AI Pulse가 AI 코딩 도구를 감지할 수 있게 합니다. 데이터는 기기에 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda acesso à sua pasta pessoal para que o AI Pulse possa detectar suas ferramentas de codificação IA. Os dados permanecem na sua máquina."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予主目录的访问权限，以便 AI Pulse 检测你的 AI 编程工具。数据保留在本机。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予主目錄的存取權限，以便 AI Pulse 偵測你的 AI 程式開發工具。資料保留在本機。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予主目錄的存取權限，以便 AI Pulse 偵測你的 AI 程式開發工具。資料保留在本機。"
          }
        }
      }
    },
    "bookmark.repos_message" : {
      "comment" : "Keep translation short — UI label, avoid layout overflow",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Verzeichnis mit Code-Repos (z.B. ~/dev). AI Pulse durchsucht Git-Repos nach Code-Änderungen. Nicht direkt das Home-Verzeichnis wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a directory that holds your code repositories (e.g. ~/dev). AI Pulse will scan it for Git repos to track code changes. Avoid selecting your home folder directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un directorio con tus repositorios (ej. ~/dev). AI Pulse escaneará repos Git para rastrear cambios. Evita seleccionar tu carpeta de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier contenant vos dépôts de code (ex. ~/dev). AI Pulse analysera les dépôts Git. Évitez de sélectionner votre dossier personnel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードリポジトリを格納するディレクトリ（例: ~/dev）を選択。AI Pulse が Git リポジトリをスキャンしてコード変更を追跡します。ホームディレクトリの直接選択は避けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드 저장소가 있는 디렉토리(예: ~/dev)를 선택하세요. AI Pulse가 Git 저장소를 스캔하여 코드 변경을 추적합니다. 홈 폴더 직접 선택은 피하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um diretório com seus repositórios (ex. ~/dev). AI Pulse escaneará os repositórios Git. Evite selecionar a pasta inicial."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择存放代码仓库的目录（例如 ~/dev），AI Pulse 将扫描其中的 Git 仓库以统计代码变化。建议不要直接选择主目录。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揀一個存放程式碼儲存庫嘅目錄（例如 ~/dev）。AI Pulse 會掃描 Git 儲存庫以追蹤程式碼變更。避免直接選擇家目錄。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個存放程式碼儲存庫的目錄（例如 ~/dev）。AI Pulse 將掃描 Git 儲存庫以追蹤程式碼變更。請避免直接選擇家目錄。"
          }
        }
      }
    },
