    "general.subscription_cycle_desc": {
      "comment": "Explains that subscriptions show as fixed cycle cost, not amortized",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Kosten pro Zyklus — keine Tagesaufteilung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed cost per cycle — never split into days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Costo fijo por ciclo — nunca se divide por día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coût fixe par cycle — jamais réparti par jour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周期ごとの固定費 — 日割りしません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기당 고정 비용 — 일별 분할 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Custo fixo por ciclo — nunca dividido por dia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按周期显示固定成本，不按天均摊"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "按週期顯示固定成本，不按天均攤"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "按週期顯示固定成本，不按天均攤"
          }
        }
      }
