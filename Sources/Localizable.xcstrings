    "Scans only your selected development folders to find Git repositories and track code changes, independently of home-folder log access.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した開発フォルダのみをスキャンしてGitリポジトリを検出し、コード変更を追跡します。ホームフォルダのログアクセスとは独立しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只扫描你指定的开发目录，用于发现 Git 仓库和统计代码变更；与主目录中的工具日志授权独立。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只掃描你指定的開發資料夾，用於發現 Git 儲存庫和統計程式碼變更；與主資料夾中的工具記錄授權獨立。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只掃描你指定的開發資料夾，用於發現 Git 儲存庫和統計程式碼變更；與主資料夾中的工具記錄授權獨立。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 개발 폴더만 스캔하여 Git 저장소를 찾고 코드 변경을 추적합니다. 홈 폴더 로그 접근과는 독립적입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannt nur die gewählten Entwicklungsordner, um Git-Repositorys zu finden und Codeänderungen zu verfolgen, unabhängig vom Protokollzugriff auf den Home-Ordner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse uniquement les dossiers de développement sélectionnés pour trouver les dépôts Git et suivre les modifications du code, indépendamment de l’accès aux journaux du dossier de départ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo escanea las carpetas de desarrollo seleccionadas para encontrar repositorios Git y seguir cambios de código, con independencia del acceso a los registros de la carpeta de inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica somente as pastas de desenvolvimento selecionadas para encontrar repositórios Git e acompanhar alterações de código, independentemente do acesso aos registros da pasta pessoal."
          }
        }
      }
    },
