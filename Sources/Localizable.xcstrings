          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "部分本機日誌讀取或寫入失敗；空白圖表不代表沒有活動。"
          }
        }
      }
    },
    "source.local_scan.inactive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Erfassung läuft nicht. Historische Summen belegen keine aktuelle Inaktivität."
          }
        },
        "en": {
