    "notifications.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control system notifications, consumption sounds, and quiet-time behavior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム通知、消費通知音、通知休止時間の動作を管理します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理系统通知、消费提示音和免打扰行为。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "管理系統通知、消費提示音和免打擾行為。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "管理系統通知、消費提示音和免打擾行為。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 알림, 소비 알림음 및 방해 금지 시간 동작을 관리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemmitteilungen, Verbrauchstöne und Verhalten in Ruhezeiten steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les notifications système, les sons de consommation et le comportement pendant les heures de silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla las notificaciones del sistema, los sonidos de consumo y el comportamiento del horario silencioso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle as notificações do sistema, os sons de consumo e o comportamento no horário silencioso."
          }
        }
      }
    },
