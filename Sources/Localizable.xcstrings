    "This simulator build has no iCloud access. Use explicit preview data to inspect the UI; verify real sync on a signed device build.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシミュレータビルドではiCloudにアクセスできません。明示的なプレビューデータでUIを確認し、実際の同期は署名済みの実機ビルドで検証してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模拟器包未启用 iCloud 权限。可运行预览数据检查界面；真实同步需要在签名设备包中验证。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "目前模擬器包未啓用 iCloud 權限。可運行預覽資料檢查界面；真實同步需要在簽名裝置包中驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "目前模擬器包未啓用 iCloud 權限。可運行預覽資料檢查界面；真實同步需要在簽名裝置包中驗證。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시뮬레이터 빌드에는 iCloud 접근 권한이 없습니다. 명시적인 미리보기 데이터로 UI를 확인하고 실제 동기화는 서명된 기기 빌드에서 검증하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Simulator-Build hat keinen iCloud-Zugriff. Prüfe die Oberfläche mit expliziten Vorschaudaten und die echte Synchronisierung mit einem signierten Geräte-Build."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version du simulateur n’a pas accès à iCloud. Utilisez des données d’aperçu explicites pour vérifier l’interface et une version signée sur appareil pour la synchronisation réelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación del simulador no tiene acceso a iCloud. Usa datos explícitos de previsualización para revisar la interfaz y verifica la sincronización real en una compilación firmada para dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação do simulador não tem acesso ao iCloud. Use dados explícitos de pré-visualização para inspecionar a interface; verifique a sincronização real em uma compilação assinada para dispositivo."
          }
        }
      }
    },
    "This state is current, independent of the selected range; it is not quota, money or productivity.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この状態は選択期間とは無関係な現在値です。クォータ、金額、生産性を示すものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态始终代表当前时刻，不表示额度、费用或工作效率。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態始終代表目前時刻，不表示額度、費用或工作效率。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態始終代表目前時刻，不表示額度、費用或工作效率。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상태는 선택한 범위와 무관한 현재 값이며 할당량, 금액 또는 생산성을 나타내지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Status ist aktuell und unabhängig vom gewählten Zeitraum; er steht nicht für Kontingent, Geld oder Produktivität."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet état est actuel et indépendant de la période sélectionnée ; il ne représente ni quota, ni argent, ni productivité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este estado es actual e independiente del intervalo seleccionado; no representa cuota, dinero ni productividad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este estado é atual e independe do intervalo selecionado; ele não representa cota, dinheiro nem produtividade."
          }
        }
      }
    },
