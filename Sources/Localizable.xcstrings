    "source.local_scan.available": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein lokaler Scan wurde kürzlich abgeschlossen. Die Abdeckung bleibt auf zugängliche, unterstützte Protokolle beschränkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local scan recently completed. Coverage remains limited to accessible supported logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un examen local finalizó recientemente. La cobertura se limita a los registros compatibles y accesibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse locale vient de se terminer. La couverture reste limitée aux journaux pris en charge et accessibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルスキャンが最近完了しました。対象はアクセス可能な対応ログに限られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 로컬 스캔이 완료되었습니다. 범위는 접근 가능한 지원 로그로 제한됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação local foi concluída recentemente. A cobertura se limita aos registros compatíveis e acessíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近本地扫描已完成；覆盖仍限于可访问的支持日志。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的本機掃描已完成；涵蓋範圍仍限於可存取的支援日誌。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
