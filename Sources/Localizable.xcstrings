    "version.mismatch.body.ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data was written by a newer version of AI Pulse for macOS. Please update AI Pulse on this device to the latest version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据由较新版本的 macOS 版 AI Pulse 写入。请将此设备上的 AI Pulse 更新到最新版本。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料由較新版本的 macOS 版 AI Pulse 寫入。請將此裝置上的 AI Pulse 更新至最新版本。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料由較新版本的 macOS 版 AI Pulse 寫入。請將此裝置上的 AI Pulse 更新至最新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータは新しいバージョンのmacOS版AI Pulseによって書き込まれました。このデバイスのAI Pulseを最新版にアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터는 더 새로운 버전의 macOS용 AI Pulse가 기록했습니다. 이 기기의 AI Pulse를 최신 버전으로 업데이트하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten wurden von einer neueren Version von AI Pulse für macOS geschrieben. Bitte aktualisieren Sie AI Pulse auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données ont été écrites par une version plus récente d’AI Pulse pour macOS. Veuillez mettre à jour AI Pulse sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos fueron escritos por una versión más nueva de AI Pulse para macOS. Actualice AI Pulse en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes dados foram gravados por uma versão mais nova do AI Pulse para macOS. Atualize o AI Pulse neste dispositivo."
          }
        }
      }
    },
    "version.mismatch.body.macos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data was written by an older version of AI Pulse for macOS. Please update the macOS app to the latest version and let it sync again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据由较旧版本的 macOS 版 AI Pulse 写入。请将 macOS 版更新到最新版本，并让它重新同步。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料由舊版的 macOS 版 AI Pulse 寫入。請將 macOS 版更新至最新版本，並讓它重新同步。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料由舊版的 macOS 版 AI Pulse 寫入。請將 macOS 版更新至最新版本，並讓它重新同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータは古いバージョンのmacOS版AI Pulseによって書き込まれました。macOS版を最新版にアップデートし、再度同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터는 이전 버전의 macOS용 AI Pulse가 기록했습니다. macOS 앱을 최신 버전으로 업데이트한 후 다시 동기화하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten wurden von einer älteren Version von AI Pulse für macOS geschrieben. Bitte aktualisieren Sie die macOS-App und lassen Sie sie erneut synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données ont été écrites par une ancienne version d’AI Pulse pour macOS. Veuillez mettre à jour l’application macOS et la laisser se resynchroniser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos fueron escritos por una versión antigua de AI Pulse para macOS. Actualice la app de macOS y deje que se sincronice de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes dados foram gravados por uma versão antiga do AI Pulse para macOS. Atualize o app no Mac e deixe-o sincronizar novamente."
          }
        }
      }
    },
