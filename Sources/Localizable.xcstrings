    "dashboard.fixed_monthly_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angegebener monatlicher Kontext, keine beobachtete Zahlung der letzten 30 Tage; nicht in Token-Aktivität oder Kontobeträgen enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declared monthly context, not payment observed in the last 30 days; not included in token activity or account amounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto mensual declarado, no un pago observado en 30 días; excluido de la actividad de tokens y de los importes de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexte mensuel déclaré, pas un paiement observé sur 30 jours ; exclu de l’activité des tokens et des montants du compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申告された月額の背景情報です。過去30日間に観測した支払いではなく、トークン活動や口座金額に含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 입력한 월 요금 배경입니다. 최근 30일의 관측 결제가 아니며 토큰 활동이나 계정 금액에 포함하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto mensal declarado, não um pagamento observado em 30 dias; não incluído na atividade de tokens ou nos valores da conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户声明的月费背景，不是近 30 天观察到的付款；不计入词元活动或账户金额。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者聲明的月費背景，不是近 30 天觀察到的付款；不計入詞元活動或帳戶金額。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者聲明的月費背景，不是近 30 天觀察到的付款；不計入詞元活動或帳戶金額。"
          }
        }
      }
