    "general.spend_alerts_desc": {
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise anhand beobachteter Nettoabnahmen des Guthabens – keine Einzelabrechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders based on observed net balance decreases—not itemized bills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos basados en disminuciones netas observadas del saldo, no en facturas detalladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels fondés sur les diminutions nettes observées du solde, pas sur des factures détaillées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観測された残高の純減に基づく通知です。個別の請求明細ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관측된 잔액의 순감소를 기준으로 알립니다. 항목별 청구 내역이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisos baseados em reduções líquidas observadas no saldo, não em cobranças detalhadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据已观察到的余额净下降提醒；不代表逐笔账单。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "根據已觀察到的餘額淨下降提醒；不代表逐筆帳單。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "根據已觀察到的餘額淨下降提醒；不代表逐筆帳單。"
          }
        }
      }
    },
