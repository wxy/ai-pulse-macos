    "general.system_notifications_desc": {
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren, um Systemmitteilungen zu stoppen. Hinweistöne werden unten separat gesteuert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off to stop system notifications. Sound cues are controlled separately below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las notificaciones del sistema. Los sonidos se controlan por separado abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez les notifications système. Les sons se règlent séparément ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとシステム通知を停止します。通知音は下で個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 시스템 알림이 중지됩니다. 효과음은 아래에서 별도로 설정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para interromper as notificações do sistema. Os sons são controlados separadamente abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后不再发送系统通知；声音提示由下方独立控制。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後不再傳送系統通知；聲音提示由下方獨立控制。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後不再傳送系統通知；聲音提示由下方獨立控制。"
          }
        }
      }
    },
