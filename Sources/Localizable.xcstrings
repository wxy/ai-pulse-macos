    "onboarding.desc" : {
      "comment" : "Keep translation short — UI label, avoid layout overflow",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge KI-Ausgaben über alle Tools und Abos. Optional: KI-Anbieter-Guthabenüberwachung konfigurieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track AI spend across all tools and subscriptions. Optionally configure AI provider balance monitoring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastrea el gasto en IA en todas las herramientas y suscripciones. Opcionalmente configura la monitorización de saldo del proveedor IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les dépenses IA sur tous les outils et abonnements. Configurez éventuellement la surveillance du solde fournisseur IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全ツールとサブスクリプションのAI支出を追跡。オプションでAIプロバイダー残高監視を設定可能。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 도구와 구독의 AI 지출을 추적합니다. 선택적으로 AI 제공자 잔액 모니터링 구성 가능."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastreie gastos com IA em todas as ferramentas e assinaturas. Opcionalmente configure o monitoramento de saldo do provedor IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟踪所有工具和订阅的 AI 花费。也可配置 AI 服务商余额监控。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤所有工具同訂閱嘅 AI 支出。可選擇設定 AI 供應商餘額監控。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤所有工具和訂閱的 AI 支出。可選擇設定 AI 供應商餘額監控。"
          }
        }
      }
    },
