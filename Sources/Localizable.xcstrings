    "cloud.error.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check:\n• Network connection is available\n• You are signed in to iCloud in Settings\n• iCloud Drive is enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查：\n• 网络连接是否正常\n• 设置中已登录 iCloud\n• iCloud Drive 已开启"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查：\n• 網路連線是否正常\n• 設定中已登入 iCloud\n• iCloud Drive 已開啟"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查：\n• 網絡連線是否正常\n• 設定中已登入 iCloud\n• iCloud Drive 已開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下をご確認ください：\n• ネットワーク接続が有効であること\n• 設定でiCloudにサインインしていること\n• iCloud Driveが有効であること"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음을 확인하세요:\n• 네트워크 연결이 가능한지\n• 설정에서 iCloud에 로그인했는지\n• iCloud Drive가 활성화되어 있는지"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte prüfen:\n• Netzwerkverbindung verfügbar\n• In Einstellungen bei iCloud angemeldet\n• iCloud Drive aktiviert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier :\n• Connexion réseau disponible\n• Vous êtes connecté à iCloud dans Réglages\n• iCloud Drive est activé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe:\n• Conexión de red disponible\n• Ha iniciado sesión en iCloud en Ajustes\n• iCloud Drive está activado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique:\n• Conexão de rede disponível\n• Sessão iniciada no iCloud nos Ajustes\n• iCloud Drive ativado"
          }
        }
      }
    },
