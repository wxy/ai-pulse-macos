    "about.companion_missing_desc": {
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the companion app to check spending on the go and receive spend-surge alerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパニオンアプリをインストールすると、外出先で支出を確認し、支出急増アラートを受け取れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装伴侣应用后，可在手机上随时查看花费并接收花费激增提醒。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝伴侶應用程式後，可隨時在手機上查看花費並接收花費激增提醒。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝伴侶應用程式後，可隨時在手機上查看花費並接收花費激增提醒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴패니언 앱을 설치하면 이동 중에도 지출을 확인하고 지출 급증 알림을 받을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die Companion-App, um unterwegs Ausgaben zu prüfen und Warnungen bei Ausgabenspitzen zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez l’app compagnon pour consulter les dépenses en déplacement et recevoir des alertes de hausse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la app complementaria para consultar el gasto estés donde estés y recibir alertas por aumentos repentinos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o app complementar para consultar os gastos em qualquer lugar e receber alertas de picos de gastos."
          }
        }
      }
    },
