    "Fetched the latest cloud summaries and activity. Dashboard values stay the same when no new data is available.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のクラウドサマリーとアクティビティを取得しました。新しいデータがない場合、ダッシュボードの値は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读取最新云端摘要与强度。没有新数据时，仪表盘数值保持不变。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已讀取最新雲端摘要與強度。沒有新資料時，儀錶盤數值保持不變。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已讀取最新雲端摘要與強度。沒有新資料時，儀錶盤數值保持不變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 클라우드 요약과 활동을 가져왔습니다. 새 데이터가 없으면 대시보드 값은 그대로 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neuesten Cloud-Zusammenfassungen und Aktivitäten wurden abgerufen. Ohne neue Daten bleiben die Dashboard-Werte unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les derniers résumés et l’activité du cloud ont été récupérés. Les valeurs du tableau de bord restent identiques en l’absence de nouvelles données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se obtuvieron los últimos resúmenes y la actividad de la nube. Los valores del panel no cambian cuando no hay datos nuevos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resumos e a atividade mais recentes foram obtidos da nuvem. Os valores do painel permanecem iguais quando não há novos dados."
          }
        }
      }
    },
