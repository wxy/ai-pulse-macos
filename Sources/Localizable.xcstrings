    "onboarding.authorize_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewähren Sie Lesezugriff, damit AI Pulse Ihre Tools und Repos erkennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant read access so AI Pulse can detect your coding tools and repositories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acceso de lectura para que AI Pulse detecte sus herramientas y repositorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès en lecture pour permettre à AI Pulse de détecter vos outils et dépôts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse が開発ツールとリポジトリを検出できるよう読み取りアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Pulse가 개발 도구와 저장소를 감지할 수 있도록 읽기 권한을 부여하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso de leitura para que o AI Pulse detecte suas ferramentas e repositórios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予读取权限，以便 AI Pulse 检测你的开发工具和代码仓库。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "授予讀取權限，以便 AI Pulse 偵測你的開發工具和程式碼儲存庫。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "授予讀取權限，以便 AI Pulse 偵測你的開發工具和程式碼儲存庫。"
          }
        }
      }
    },
    "onboarding.authorize_dev_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo Ihr Code liegt. Ermöglicht Repo-Scans und aider-Erkennung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where your code lives. Enables repo scanning and aider detection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde vive su código. Permite el escaneo de repositorios y la detección de aider."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où se trouve votre code. Permet l'analyse des dépôts et la détection d'aider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードがある場所。リポジトリスキャンと aider 検出に使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 있는 위치입니다. 저장소 스캔과 aider 감지에 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde seu código fica. Permite a varredura de repositórios e a detecção do aider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存放代码仓库的位置，用于仓库扫描与 aider 检测。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "存放程式碼儲存庫嘅位置，用於儲存庫掃描同 aider 偵測。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "存放程式碼儲存庫的位置，用於儲存庫掃描與 aider 偵測。"
          }
        }
