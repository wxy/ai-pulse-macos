    "Mute applies to this iPhone only. Configure directories, plans and API keys on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュートはこのiPhoneにのみ適用されます。フォルダ、プラン、APIキーはMacで設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音仅影响此 iPhone，不修改 Mac。目录授权、套餐和 API Key 请在 Mac 上配置。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "靜音僅影響此 iPhone，不修改 Mac。資料夾授權、計劃和 API Key 請在 Mac 上設定。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "靜音僅影響此 iPhone，不修改 Mac。資料夾授權、方案和 API Key 請在 Mac 上設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음소거는 이 iPhone에만 적용됩니다. 디렉터리, 요금제 및 API 키는 Mac에서 구성하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stummschaltung gilt nur für dieses iPhone. Ordner, Tarife und API-Schlüssel werden auf dem Mac konfiguriert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sourdine ne s’applique qu’à cet iPhone. Configurez les dossiers, les forfaits et les clés API sur votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El silencio solo se aplica a este iPhone. Configura carpetas, planes y claves API en tu Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo silencioso se aplica somente a este iPhone. Configure diretórios, planos e chaves de API no Mac."
          }
        }
      }
    },
