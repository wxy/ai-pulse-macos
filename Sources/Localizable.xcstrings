    "general.spend_rate_alerts_desc": {
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when spending jumps far above your recent baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出が直近の基準値を大幅に上回ったときに通知します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当花费远超近期基线时提醒。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當花費遠超近期基線時提醒。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當花費遠超近期基線時提醒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출이 최근 기준값보다 크게 증가하면 알립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn Ausgaben weit über den letzten Basiswert steigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier lorsque les dépenses dépassent largement votre référence récente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar cuando el gasto supere ampliamente tu referencia reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar quando os gastos subirem muito acima da sua linha de base recente."
          }
        }
      }
    },
