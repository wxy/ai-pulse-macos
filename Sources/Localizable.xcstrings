    "Outer: today's tokens. Middle: added plus deleted code lines. Inner: current AI activity.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外側: 今日のトークン。中央: 追加行数と削除行数の合計。内側: 現在のAIアクティビティ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外圈：今日词元。中圈：今日代码新增与删除行数之和。内圈：当前 AI 活动强度。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "外圈：今日詞元。中圈：今日程式碼新增與刪除行數之和。內圈：目前 AI 活動強度。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "外圈：今日詞元。中圈：今日程式碼新增與刪除行數之和。內圈：目前 AI 活動強度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바깥쪽: 오늘의 토큰. 가운데: 추가 및 삭제된 코드 줄의 합계. 안쪽: 현재 AI 활동."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außen: heutige Tokens. Mitte: hinzugefügte plus gelöschte Codezeilen. Innen: aktuelle AI-Aktivität."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extérieur : jetons du jour. Milieu : lignes de code ajoutées et supprimées. Intérieur : activité AI actuelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
