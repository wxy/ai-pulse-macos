    "Access to this folder allows detection and reading of the local logs below.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダへのアクセスを許可すると、以下のツールが保存したローカルログを検出して読み取れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权此目录后，可检测并读取下面这些工具保存的本地日志。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "授權此資料夾後，可偵測並讀取下面這些工具儲存的本地記錄。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "授權此資料夾後，可偵測並讀取下面這些工具儲存的本地記錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 대한 접근을 허용하면 아래 로컬 로그를 감지하고 읽을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf diesen Ordner ermöglicht das Erkennen und Lesen der folgenden lokalen Protokolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à ce dossier permet de détecter et de lire les journaux locaux ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a esta carpeta permite detectar y leer los registros locales indicados a continuación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso a esta pasta permite detectar e ler os registros locais abaixo."
          }
        }
      }
    },
