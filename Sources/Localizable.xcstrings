    "panel.activity_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens describe activity, not a bill. Output covers repositories touched by this tool, not proof of AI authorship. Expand a session for its full context history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはアクティビティを示すもので、請求額ではありません。出力はこのツールが操作したリポジトリを対象とし、AIによる作成の証明ではありません。セッションを展開すると完全なコンテキスト履歴を確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词元反映活动，不代表账单。产出来自此工具涉及的仓库，不代表 AI 创作归属。点击会话可查看完整上下文历史。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "詞元反映活動，不代表賬單。產出來自此工具涉及的儲存庫，不代表 AI 創作歸屬。點擊會話可查看完整上下文歷史。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞元反映活動，不代表賬單。產出來自此工具涉及的儲存庫，不代表 AI 創作歸屬。點擊會話可查看完整上下文歷史。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 활동을 설명할 뿐 청구서가 아닙니다. 결과물은 이 도구가 다룬 저장소를 나타내며 AI 작성의 증거가 아닙니다. 세션을 펼치면 전체 컨텍스트 기록을 볼 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens beschreiben Aktivität, keine Rechnung. Ausgabe umfasst von diesem Tool berührte Repositorys und beweist keine AI-Autorenschaft. Erweitere eine Sitzung für den vollständigen Kontextverlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons décrivent l’activité, pas une facture. La sortie couvre les dépôts utilisés par cet outil et ne prouve pas une paternité AI. Développez une session pour voir tout son historique contextuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens describen actividad, no una factura. La producción abarca los repositorios modificados por esta herramienta, no demuestra autoría de IA. Despliega una sesión para ver todo su historial de contexto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens descrevem atividade, não uma fatura. A produção abrange repositórios alterados por esta ferramenta, não comprova autoria da IA. Expanda uma sessão para ver todo o histórico de contexto."
          }
        }
      }
    },
