    "Optional account observations; they do not complete local tokens or affect activity tracking.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント観測は任意です。ローカルトークンを補完せず、アクティビティ追跡にも影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选账户观测，不补全本地词元，也不影响基础活动统计。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可選帳戶觀測，不補全本地詞元，也不影響基礎活動統計。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可選帳戶觀測，不補全本地詞元，也不影響基礎活動統計。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항인 계정 관측으로, 로컬 토큰을 보완하거나 활동 추적에 영향을 주지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Kontobeobachtungen; sie ergänzen lokale Tokens nicht und beeinflussen die Aktivitätserfassung nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observations de compte facultatives ; elles ne complètent pas les jetons locaux et n’affectent pas le suivi de l’activité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observaciones de cuenta opcionales; no completan los tokens locales ni afectan al seguimiento de actividad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observações opcionais da conta; elas não complementam os tokens locais nem afetam o acompanhamento de atividade."
          }
        }
      }
    },
