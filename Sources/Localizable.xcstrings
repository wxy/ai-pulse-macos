    "Watch reads Mac summaries from the same Apple account’s iCloud. Refreshing does not trigger a Mac upload.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchは同じAppleアカウントのiCloudからMacのサマリーを読み取ります。更新してもMacからのアップロードは開始されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表从同一 Apple 账户的 iCloud 读取 Mac 摘要。重新同步不会触发 Mac 上传。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "手錶從同一 Apple 帳戶的 iCloud 讀取 Mac 摘要。重新同步不會觸發 Mac 上傳。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "手錶從同一 Apple 帳戶的 iCloud 讀取 Mac 摘要。重新同步不會觸發 Mac 上傳。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch는 같은 Apple 계정의 iCloud에서 Mac 요약을 읽습니다. 새로 고쳐도 Mac 업로드가 시작되지는 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Watch liest Mac-Zusammenfassungen aus iCloud desselben Apple Accounts. Eine Aktualisierung löst keinen Mac-Upload aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Watch lit les résumés du Mac dans l’iCloud du même compte Apple. L’actualisation ne déclenche aucun envoi depuis le Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Watch lee los resúmenes del Mac desde el iCloud de la misma cuenta de Apple. Actualizar no inicia una carga desde el Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Watch lê os resumos do Mac no iCloud da mesma Conta Apple. Atualizar não inicia um envio pelo Mac."
          }
        }
      }
    },
