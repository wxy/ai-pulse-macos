    "general.balance_drop_alerts_desc": {
      "comment": "Keep translation short — UI label, avoid layout overflow",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when a provider balance drops sharply (most reliable)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダー残高が急減したときに通知します（最も信頼性が高い方法）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当服务商余额大幅下降时提醒（最可靠）。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當服務商餘額大幅下降時提醒（最可靠）。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當服務商餘額大幅下降時提醒（最可靠）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공업체 잔액이 급격히 감소하면 알립니다(가장 신뢰할 수 있음)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn ein Anbieterguthaben stark sinkt (am zuverlässigsten)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier lorsque le solde d’un fournisseur chute fortement (le plus fiable)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar cuando el saldo de un proveedor caiga bruscamente (más fiable)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar quando o saldo de um provedor cair bruscamente (mais confiável)."
          }
        }
      }
    },
