    "dashboard.repo_code_changes_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügte + gelöschte Zeilen autorisierter Git-Repositories; kein Nettozuwachs oder Nachweis von KI-Autorschaft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added + deleted lines in authorized Git repositories; not net growth or AI authorship."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Líneas añadidas + eliminadas en repositorios Git autorizados; no es crecimiento neto ni prueba de autoría de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignes ajoutées + supprimées dans les dépôts Git autorisés ; ni croissance nette ni preuve d’auteur IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可された Git リポジトリの追加行＋削除行。純増や AI の著作帰属ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용된 Git 저장소의 추가 행＋삭제 행입니다. 순증가나 AI 작성 증명이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas adicionadas + removidas em repositórios Git autorizados; não é crescimento líquido nem prova de autoria por IA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权 Git 仓库的增加行＋删除行；不是净增长，也不证明 AI 创作归属。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "授權 Git 倉庫的增加行＋刪除行；不是淨增長，也不證明 AI 創作歸屬。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "授權 Git 倉庫的增加行＋刪除行；不是淨增長，也不證明 AI 創作歸屬。"
          }
        }
      }
    },
    "dashboard.repo_data_bar_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens und Commits nutzen jeweils ihren größten Repository-Wert. Hinzugefügte und gelöschte Zeilen teilen eine Skala. Aufklappen ändert die Skala nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token and commit columns each use their own largest repository value. Added and deleted lines share one scale. Expanding the list does not change the scale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens y commits usan cada uno el máximo por repositorio. Las líneas añadidas y eliminadas comparten escala. Ampliar la lista no cambia la escala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetons et commits utilisent chacun le maximum par dépôt. Ajouts et suppressions partagent une échelle. Déplier la liste ne modifie pas l’échelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンとコミットはそれぞれリポジトリ最大値で表示します。追加・削除行は同じ尺度を使います。リスト展開で尺度は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰과 커밋은 각각 저장소 최댓값을 기준으로 표시합니다. 추가·삭제 행은 같은 배율을 사용하며 목록을 펼쳐도 배율이 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens e commits usam seus respectivos máximos por repositório. Linhas adicionadas e removidas compartilham uma escala. Expandir a lista não altera a escala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词元和提交分别按各自仓库最大值缩放；增加行与删除行使用同一尺度。展开列表不会改变尺度。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "詞元和提交分別按各自倉庫最大值縮放；增加行與刪除行使用同一尺度。展開列表不會改變尺度。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞元和提交分別按各自倉庫最大值縮放；增加行與刪除行使用同一尺度。展開列表不會改變尺度。"
          }
        }
      }
    },
