    "dashboard.code_composition_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben: gelöschte Zeilen. Unten: hinzugefügte Zeilen. Höhe zeigt den Anteil aller geänderten Zeilen, nicht die Fläche. Ohne Änderungen bleibt ein neutraler Platzhalter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top: deleted lines. Bottom: added lines. Height shows each share of all changed lines; area is not a quantity. No changes leaves a neutral placeholder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba: líneas eliminadas. Abajo: añadidas. La altura indica su proporción de líneas modificadas, no el área. Sin cambios, se mantiene un marcador neutro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut : lignes supprimées. En bas : lignes ajoutées. La hauteur indique leur part des lignes modifiées, pas la surface. Sans changement, affichage neutre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上は削除行、下は追加行。高さは変更行全体に対する比率で、面積は数量ではありません。変更なしは中立表示です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위는 삭제 행, 아래는 추가 행입니다. 높이는 전체 변경 행 중 비율이며 면적은 수량이 아닙니다. 변경이 없으면 중립 표시를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima: linhas removidas. Abaixo: adicionadas. A altura indica a proporção das linhas alteradas, não a área. Sem alterações, mantém-se um marcador neutro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上部为删除行，下部为增加行；高度表示各自占全部变化行的比例，面积不表示数量。无变化时保留中性占位。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "上部為刪除行，下部為增加行；高度表示各自佔全部變化行的比例，面積不表示數量。無變化時保留中性佔位。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "上部為刪除行，下部為增加行；高度表示各自佔全部變化行的比例，面積不表示數量。無變化時保留中性佔位。"
          }
        }
      }
    },
