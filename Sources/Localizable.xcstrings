    "dashboard.balance_observation_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoabnahmen des Guthabens zwischen Messungen, beeinflusst durch Aufladungen, Erstattungen und andere Vorgänge – keine Einzelabrechnungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net balance decreases between samples, affected by top-ups, refunds and other activity—not itemized bills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descensos netos de saldo entre muestras, afectados por recargas, reembolsos y otras operaciones; no son facturas detalladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisses nettes du solde entre relevés, influencées par les recharges, remboursements et autres opérations — pas des factures détaillées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプル間の残高純減少です。チャージ、返金、その他の活動の影響を含む場合があり、個別の請求ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 사이의 잔액 순감소입니다. 충전, 환불 및 기타 활동의 영향을 포함할 수 있으며 개별 청구 내역이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduções líquidas de saldo entre amostras, afetadas por recargas, reembolsos e outras atividades — não são faturas detalhadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下为采样间余额净下降，可能包含充值、退款及其他活动的影响，并非逐笔账单。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "以下為採樣間結餘淨下降，可能包含增值、退款及其他活動的影響，並非逐筆帳單。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "以下為採樣間餘額淨下降，可能包含儲值、退款及其他活動的影響，並非逐筆帳單。"
          }
        }
      }
    },
